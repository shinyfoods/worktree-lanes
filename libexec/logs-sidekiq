#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091,SC2119  # loader is sourced from the installed CLI root and intentionally receives no caller args
. "$WTL_ROOT/lib/env.sh"
# shellcheck disable=SC2119  # service arguments are not env-loader arguments
wtl_load_env

if [ "${WTL_HAS_SIDEKIQ:-0}" = "0" ]; then
  echo "worktree logs-sidekiq: sidekiq is not configured for this project (WTL_HAS_SIDEKIQ=0)" >&2
  exit 0
fi

exec docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" logs -f sidekiq "$@"
