#!/usr/bin/env bash
# Starts an isolated compose lane for the current worktree (backend/frontend/postgres/redis/mailhog/sidekiq optional).

set -euo pipefail

# shellcheck source=lib/ci_compose_retry.sh
. "$WTL_ROOT/lib/ci_compose_retry.sh"

WITH_SIDEKIQ=1
DETACH=0
BUILD_MODE=""
for arg in "$@"; do
  case "$arg" in
    --no-sidekiq) WITH_SIDEKIQ=0 ;;
    -d|--detach) DETACH=1 ;;
    --build) BUILD_MODE="--build" ;;
    --no-build) BUILD_MODE="--no-build" ;;
  esac
done

wtl_load_env --infra-mode=isolated
if ! docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" ps -q | grep -q .; then
  worktree env --check-ports --infra-mode=isolated >/dev/null
fi

# Rebuild a persistent local lane's image when Gemfile.lock changed. Skipped in
# CI, where lanes build the image fresh (via --build or compose auto-build).
if [ "${GITHUB_ACTIONS:-}" != "true" ]; then
  worktree sync-gems
fi

run_compose_up_detached() {
  local -a compose_args=()
  if [ -n "$BUILD_MODE" ]; then
    compose_args+=("$BUILD_MODE")
  fi
  compose_args+=("$@")

  if [ "${GITHUB_ACTIONS:-}" = "true" ] && command -v flock >/dev/null 2>&1; then
    # Prevent a check-then-bind race between concurrent CI lane startups on the same host.
    local lock_file="/tmp/${WTL_PROJECT}-ci-lane-start.lock"
    exec 9>"$lock_file"
    flock 9
    # Re-check ports inside the lock if this project is not already up.
    if ! docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" ps -q | grep -q .; then
      worktree env --check-ports --infra-mode=isolated >/dev/null
    fi
    wtl_compose_up_with_ci_retry "lane-up" -- "${compose_args[@]}"
    flock -u 9
    exec 9>&-
  else
    docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" up -d "${compose_args[@]}"
  fi
}

services=(postgres redis mailhog backend frontend)

echo "Compose project: $COMPOSE_PROJECT_NAME"
echo "Frontend: $WTL_FRONTEND_URL"
echo "API:      $WTL_API_BASE_URL"
echo "MailHog:  http://localhost:$WTL_MAILHOG_UI_PORT"
# The published-port check reads `docker compose port` output, whose shape differs between
# compose versions. Recording the version on every bring-up means a future mismatch is
# diagnosable from the log rather than by guessing at the runner's toolchain.
echo "Compose:  $(docker compose version --short 2>/dev/null || echo unknown)"

if [ "$DETACH" -eq 1 ]; then
  run_compose_up_detached "${services[@]}"
  if [ "$WITH_SIDEKIQ" -eq 1 ]; then
    run_compose_up_detached sidekiq
  fi
  # Wait for HTTP endpoints used by E2E.
  targets=(
    "$WTL_FRONTEND_URL"
    "$WTL_API_BASE_URL/csrf_token"
    "$WTL_MAILHOG_API_URL/v2/messages"
  )
  # CI preview mode serves a built SPA; verify deep-link fallback works or E2E will 404 on /login.
  if [ "${WTL_FRONTEND_RUN_MODE:-dev}" = "preview" ]; then
    targets+=("$WTL_FRONTEND_URL/login")
  fi
  # Which compose service backs each readiness target. Same mapping the timeout
  # diagnostic below uses to pick a log stream.
  service_for_target() {
    case "$1" in
      "$WTL_FRONTEND_URL"|"$WTL_FRONTEND_URL/login") echo "frontend" ;;
      "$WTL_API_BASE_URL/csrf_token") echo "backend" ;;
      "$WTL_MAILHOG_API_URL/v2/messages") echo "mailhog" ;;
      *) echo "" ;;
    esac
  }

  # The container port each probed service publishes to the host. Only services that
  # appear in service_for_target need an entry; a service with no entry is skipped by
  # the binding check rather than assumed broken.
  container_port_for_service() {
    case "$1" in
      frontend) echo "5173" ;;
      backend)  echo "3000" ;;
      mailhog)  echo "8025" ;;
      *) echo "" ;;
    esac
  }

  # Fails SAFE: any doubt about the listing — command error, empty output, no docker —
  # reports the service as running, so a transient docker hiccup can never abort a wait
  # that would have succeeded. Only a listing that is readable AND omits the service
  # counts as evidence the container is gone.
  compose_service_running() {
    local running
    running="$(docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" ps --services --status running 2>/dev/null)" || return 0
    [ -n "$running" ] || return 0
    printf '%s\n' "$running" | grep -qx "$1"
  }

  # A running container whose ports mapping was never applied can never be reached, and
  # is indistinguishable from a slow one until the budget expires: the container reports
  # Up, the app inside logs a clean boot, and the host port simply does not exist. Seen
  # repeatedly on this project's post-merge lane, on a different service each time, with
  # compose reporting success every time.
  #
  # Two earlier versions of this check could never fire, each because it encoded a guessed
  # shape of `docker compose port` rather than a measured one. Measured on Compose v5.3.1:
  #
  #   published                  rc 0  "0.0.0.0:55000"
  #   running, NOT published     rc 0  "invalid IP:0"        <-- the defect shape
  #   port not declared          rc 1  "no port 8025/tcp for container <name>: ..."
  #   stopped / unknown service  rc 1  "service \"<name>\" is not running"
  #
  # So the verdict is taken from a POSITIVE shape -- output that IS a host:port with a
  # non-zero port -- rather than from a list of failure strings. That list has grown a hole
  # on every attempt, and each hole was invisible because the tests encoded the same list.
  # An unrecognised success now fails toward detection rather than toward silence.
  #
  # Liveness is checked before this, so a stopped service is already handled there; a
  # docker that cannot answer must never abort a wait that would have succeeded.
  compose_service_published() {
    local cport out rc mapping
    cport="$(container_port_for_service "$1")"
    [ -n "$cport" ] || return 0
    out="$(docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" port "$1" "$cport" 2>&1)"
    rc=$?

    if [ "$rc" -eq 0 ]; then
      mapping="$(printf '%s\n' "$out" | tail -n 1)"
      # host:port with a non-zero port. "invalid IP:0" fails on both counts.
      printf '%s' "$mapping" | grep -Eq '^[^[:space:]]+:[1-9][0-9]*$' && return 0
      return 1
    fi

    case "$out" in
      # Liveness owns this diagnosis; reporting it here would mislabel a crash.
      *"is not running"*) return 0 ;;
      # Older compose wording, and the not-declared shape. Both are definite negatives.
      *"no public port"*|*"no port "*) return 1 ;;
      # Daemon unreachable, docker absent, anything unmodelled: fail SAFE.
      *) return 0 ;;
    esac
  }

  # Emits one labelled line per probe, ALWAYS -- a probe whose command is missing prints
  # "unavailable" rather than nothing, because a silently empty section is indistinguishable
  # from a probe that ran and found nothing. Purely diagnostic: runs after the verdict is
  # already decided and must never change it.
  probe() {
    local label="$1"; shift
    local out
    if ! command -v "$1" >/dev/null 2>&1; then
      echo "  $label: unavailable ($1 not on PATH)" >&2
      return 0
    fi
    if out="$("$@" 2>&1)"; then
      if [ -n "$out" ]; then
        printf '  %s: %s\n' "$label" "$(printf '%s' "$out" | tr '\n' ' ')" >&2
      else
        echo "  $label: (empty)" >&2
      fi
    else
      printf '  %s: unavailable (%s)\n' "$label" "$(printf '%s' "$out" | tr '\n' ' ' | cut -c1-160)" >&2
    fi
    return 0
  }

  # Host-side facts for the dropped-binding investigation. Collected at the moment the
  # binding check fires, because the defect is intermittent: a diagnostic run launched
  # separately lands on a healthy lane and settles nothing.
  dump_binding_forensics() {
    local svc="$1" cport="$2" cid
    echo "Host forensics for the missing binding:" >&2

    cid="$(docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" ps -q "$svc" 2>/dev/null | head -n 1)"
    if [ -n "$cid" ]; then
      # Distinguishes "mapping absent" from "mapping present but unbound" -- `ps` shows the
      # same bare "<port>/tcp" for both, and they implicate different layers.
      probe "inspect ports" docker inspect -f '{{json .NetworkSettings.Ports}}' "$cid"
      probe "container state" docker inspect -f '{{.State.Status}} started={{.State.StartedAt}}' "$cid"
    else
      echo "  inspect ports: unavailable (no container id for $svc)" >&2
    fi

    probe "docker-proxy count" sh -c 'pgrep -c docker-proxy || echo 0'
    probe "ephemeral range" sh -c 'cat /proc/sys/net/ipv4/ip_local_port_range 2>/dev/null || sysctl -n net.ipv4.ip_local_port_range'
    probe "open sockets" sh -c 'ss -ant 2>/dev/null | wc -l'
    probe "compose projects on host" sh -c 'docker ps --format "{{.Label \"com.docker.compose.project\"}}" | sort -u | grep -c . || echo 0'
    probe "published ports on host" sh -c 'docker ps --format "{{.Ports}}" | tr "," "\n" | grep -c "->" || echo 0'
    probe "docker version" docker version --format '{{.Server.Version}} api={{.Server.APIVersion}}'
    local dpid
    dpid="$(pgrep -o dockerd 2>/dev/null || true)"
    if [ -n "$dpid" ]; then
      probe "daemon uptime" ps -o etime= -p "$dpid"
    else
      echo "  daemon uptime: unavailable (no dockerd pid)" >&2
    fi
    probe "dockerd bind errors" sh -c 'journalctl -u docker --since "-5 min" --no-pager 2>&1 | grep -iE "bind|port" | tail -n 5'
    echo "  (probe target: $svc container port $cport)" >&2
  }

  for target in "${targets[@]}"; do
    echo "Waiting for $target ..."
    ready=0
    stopped_service=""
    unpublished_service=""
    max_attempts=60
    if [ "$target" = "$WTL_FRONTEND_URL" ] && [ "${WTL_FRONTEND_RUN_MODE:-dev}" = "preview" ]; then
      # Preview mode performs a Vite production build on startup; allow extra warmup time in CI.
      max_attempts=180
    fi
    if [ "${GITHUB_ACTIONS:-}" = "true" ] && [ "$target" != "$WTL_FRONTEND_URL" ]; then
      # Under heavy nightly load, backend/mailhog can take longer to accept
      # requests even after containers are created.
      max_attempts=120
    fi
    for attempt in $(seq 1 "$max_attempts"); do
      # Keep readiness checks bounded; a half-open HTTP connection can otherwise hang curl indefinitely.
      if command -v curl >/dev/null 2>&1 && curl -fsS --connect-timeout 1 --max-time 2 "$target" >/dev/null 2>&1; then
        echo "Ready: $target"
        ready=1
        break
      fi
      if [ $((attempt % 5)) -eq 0 ]; then
        echo "Still waiting for $target ($attempt/$max_attempts)"
        # A container that has exited will never become ready, so waiting out the
        # remaining budget only converts a crash into an indistinguishable timeout.
        # Checked on the progress cadence rather than every second to keep this to one
        # docker call per five attempts.
        probe_service="$(service_for_target "$target")"
        if [ -n "$probe_service" ] && ! compose_service_running "$probe_service"; then
          stopped_service="$probe_service"
          break
        fi
        # Checked after liveness, never before: a container that has exited also has no
        # published port, and "not running" is the more accurate of the two diagnoses.
        if [ -n "$probe_service" ] && ! compose_service_published "$probe_service"; then
          unpublished_service="$probe_service"
          break
        fi
      fi
      sleep 1
    done
    if [ "$ready" -ne 1 ]; then
      if [ -n "$stopped_service" ]; then
        echo "Service '$stopped_service' is not running — it exited or never started; abandoning the readiness wait for $target" >&2
      elif [ -n "$unpublished_service" ]; then
        echo "Service '$unpublished_service' is running but has no published host port for container port $(container_port_for_service "$unpublished_service") — compose created the container without the requested mapping, so $target can never be reached; abandoning the readiness wait" >&2
      else
        echo "Timed out waiting for $target" >&2
      fi
      if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
        echo "Compose status after readiness timeout:" >&2
        docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" ps >&2 || true
        if [ -n "$unpublished_service" ]; then
          dump_binding_forensics "$unpublished_service" "$(container_port_for_service "$unpublished_service")"
        fi
        case "$target" in
          "$WTL_FRONTEND_URL"|"$WTL_FRONTEND_URL/login")
            echo "Recent frontend logs:" >&2
            docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" logs --tail=80 frontend >&2 || true
            ;;
          "$WTL_API_BASE_URL/csrf_token")
            echo "Recent backend logs:" >&2
            docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" logs --tail=80 backend >&2 || true
            ;;
          "$WTL_MAILHOG_API_URL/v2/messages")
            echo "Recent mailhog logs:" >&2
            docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" logs --tail=80 mailhog >&2 || true
            ;;
        esac
      fi
      exit 1
    fi
  done
else
  if [ "$WITH_SIDEKIQ" -eq 1 ]; then
    exec docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" up ${BUILD_MODE:+$BUILD_MODE} "${services[@]}" sidekiq
  fi
  exec docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE" up ${BUILD_MODE:+$BUILD_MODE} "${services[@]}"
fi
