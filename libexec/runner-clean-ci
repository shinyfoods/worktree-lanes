#!/usr/bin/env bash
# Best-effort janitor for leaked CI Docker Compose projects on a self-hosted runner.
# Ported from upstream; all project-specific literals replaced by project-derived
# values (WTL_PROJECT prefix) read from the worktree config.
# shellcheck disable=SC1091  # sourced lib files are located at runtime via WTL_ROOT

set -euo pipefail

# Resolve install root (same logic as bin/worktree so this script can run standalone).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$dir/$SOURCE"
done
WTL_LIBEXEC="$(cd -P "$(dirname "$SOURCE")" && pwd)"
WTL_ROOT="$(cd "$WTL_LIBEXEC/.." && pwd)"

# Load config to get WTL_PROJECT (needed for default prefix).
# shellcheck source=../lib/config.sh
. "$WTL_ROOT/lib/config.sh"
if ! wtl_load_config 2>/dev/null; then
  # If no worktree.config found we can still run if WTL_PROJECT is set externally.
  : "${WTL_PROJECT:?runner-clean-ci: WTL_PROJECT not set and no worktree.config found}"
fi
WTL_PROJECT="${WTL_CFG_PROJECT:-$WTL_PROJECT}"

# Derive compose file (main repo root / docker-compose.yml).
# shellcheck source=../lib/derive.sh
. "$WTL_ROOT/lib/derive.sh"
# shellcheck source=../lib/emit.sh
. "$WTL_ROOT/lib/emit.sh"
wtl_derive
COMPOSE_FILE="$WTL_COMPOSE_FILE"

APPLY=0
INCLUDE_RUNNING=0
MAX_AGE_MINUTES=""
# A floor, not a budget. Anything newer than this is left alone by a sweep,
# because a compose project that young cannot be distinguished from one that is
# mid-startup — and getting that wrong kills a live job.
MIN_AGE_MINUTES="${WTL_JANITOR_MIN_AGE_MINUTES:-5}"
PREFIX="${WTL_PROJECT}-ci-"
PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --include-running) INCLUDE_RUNNING=1 ;;
    --max-age=*) MAX_AGE_MINUTES="${1#*=}" ;;
    --min-age=*) MIN_AGE_MINUTES="${1#*=}" ;;
    --prefix=*) PREFIX="${1#*=}" ;;
    --project=*) PROJECT="${1#*=}" ;;
    -h|--help)
      cat <<EOF
Usage:
  worktree runner-clean-ci [--apply] [--include-running] [--max-age=MINUTES] [--prefix=${WTL_PROJECT}-ci-]
  worktree runner-clean-ci [--apply] [--include-running] --project=<compose-project>

Defaults:
  - Dry-run (prints what would be cleaned)
  - Only cleans projects with no running containers (unless --include-running or --max-age)

Options:
  --min-age=MINUTES   Never clean a project with ANY container newer than MINUTES (default 5).
                      A sweep cannot tell a project that is starting from one that is finished:
                      a compose-run project holds one container that reports as not-running
                      between Created and Started, and cleaning it there removes the network out
                      from under a live command. Ignored for an explicit --project or
                      --include-running, which are deliberate.
  --max-age=MINUTES   Treat a project whose NEWEST container is older than MINUTES as stale
                      and reap it regardless of RUNNING state. This is what catches a stack
                      stranded by a job that was cancelled or killed before its teardown
                      ran. Set it above the longest legitimate job on the host, or it will
                      reap live work. Projects younger than MINUTES are still subject to
                      the normal --include-running check.

Examples:
  worktree runner-clean-ci
  worktree runner-clean-ci --apply
  worktree runner-clean-ci --apply --max-age=120
  worktree runner-clean-ci --apply --include-running
  worktree runner-clean-ci --apply --include-running --project=${WTL_PROJECT}-ci-1234abcd
EOF
      exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      exit 1
      ;;
  esac
  shift
done

if ! command -v docker >/dev/null 2>&1; then
  echo "docker not found" >&2
  exit 1
fi

# Docker's `{{.CreatedAt}}` is Go's layout `2006-01-02 15:04:05 -0700 MST`: a
# numeric offset AND a trailing zone abbreviation. GNU date — the one on a Linux
# CI runner — rejects the whole string because of that abbreviation, and the BSD
# form does not exist there, so both arms of the old two-arm parse failed and
# every age check silently answered "no". Dropping the abbreviation leaves a
# string both implementations accept. Prints the epoch; returns 1 when the
# timestamp cannot be read.
parse_docker_timestamp() {
  local ts="$1" d t z rest epoch
  read -r d t z rest <<< "$ts"
  [ -n "$d" ] && [ -n "$t" ] && [ -n "$z" ] || return 1
  epoch=$(date -d "$d $t $z" +%s 2>/dev/null || date -j -f "%Y-%m-%d %H:%M:%S %z" "$d $t $z" +%s 2>/dev/null) || return 1
  [ -n "$epoch" ] || return 1
  printf '%s' "$epoch"
}

# Prints the creation epoch of the project's NEWEST container. Both age
# questions are questions about that one number: the floor asks whether it is
# too recent to touch, the ceiling whether even it is old enough to reap.
#
# Return codes are distinguished on purpose, because the two failure shapes call
# for opposite treatment:
#   1  the project has containers but an age could not be read — an unreadable
#      age is not an age, and must never be allowed to read as "old enough"
#   2  the project has no containers at all, only leaked networks or volumes,
#      which is garbage by definition and has no age to reason about
project_newest_epoch() {
  local project="$1" created_times ts epoch newest=""
  created_times=$(docker ps -a --filter "label=com.docker.compose.project=${project}" --format '{{.CreatedAt}}' 2>/dev/null) || return 2
  [ -n "$created_times" ] || return 2

  while IFS= read -r ts; do
    [ -n "$ts" ] || continue
    epoch=$(parse_docker_timestamp "$ts") || return 1
    if [ -z "$newest" ] || [ "$epoch" -gt "$newest" ]; then
      newest="$epoch"
    fi
  done <<< "$created_times"

  [ -n "$newest" ] || return 2
  printf '%s' "$newest"
}

collect_projects() {
  {
    docker ps -a --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null || true
    docker volume ls --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null || true
    docker network ls --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null || true
  } | awk 'NF' | sort -u
}

remove_labeled_resources() {
  local project="$1"
  local failed_local=0

  # `mapfile` is bash 4+. macOS ships bash 3.2, where it is not a builtin and not
  # on PATH, so every one of these lines died with "mapfile: command not found"
  # followed by an unbound-variable abort — on the very path an operator running
  # this by hand reaches. Read into the array instead; it is portable and does the
  # same thing for ids, which never contain whitespace.
  local ids

  # Remove orphaned containers first (if any remain for this project).
  ids="$(docker ps -a --filter "label=com.docker.compose.project=${project}" -q 2>/dev/null)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086  # deliberate word splitting: one id per argument
    docker rm -f $ids >/dev/null 2>&1 || failed_local=1
  fi

  # Then remove project networks and volumes by label. These are the common
  # sources of leaked state that accumulate on self-hosted CI runners.
  ids="$(docker network ls --filter "label=com.docker.compose.project=${project}" -q 2>/dev/null)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086
    docker network rm $ids >/dev/null 2>&1 || failed_local=1
  fi

  ids="$(docker volume ls --filter "label=com.docker.compose.project=${project}" -q 2>/dev/null)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086
    docker volume rm $ids >/dev/null 2>&1 || failed_local=1
  fi

  return "$failed_local"
}

projects=()
while IFS= read -r p; do
  if [ -n "$PROJECT" ]; then
    [ "$p" = "$PROJECT" ] || continue
  else
    [[ "$p" == ${PREFIX}* ]] || continue
  fi
  projects+=("$p")
done < <(collect_projects)

if [ "${#projects[@]}" -eq 0 ]; then
  if [ -n "$PROJECT" ]; then
    echo "No compose project found: $PROJECT"
  else
    echo "No compose projects found with prefix: $PREFIX"
  fi
  exit 0
fi

echo "Compose file: $COMPOSE_FILE"
if [ "$APPLY" -eq 1 ]; then _mode=apply; else _mode=dry-run; fi
echo "Mode: $_mode"
if [ -n "$PROJECT" ]; then
  echo "Project: $PROJECT"
else
  echo "Prefix: $PREFIX"
fi
[ -z "$MAX_AGE_MINUTES" ] || echo "Max age: ${MAX_AGE_MINUTES}m (projects whose newest container is older than this are reaped, running or not)"
echo

cleaned=0
skipped_running=0
skipped_young=0
undetermined=0
failed=0

lock_fd_open=0
if [ "$APPLY" -eq 1 ] && [ "${GITHUB_ACTIONS:-}" = "true" ] && command -v flock >/dev/null 2>&1; then
  # Coordinate with CI lane startup so global janitor cleanup does not race
  # a concurrent `docker compose up` and delete containers mid-start.
  lock_file="/tmp/${WTL_PROJECT}-ci-lane-start.lock"
  exec 9>"$lock_file"
  lock_fd_open=1
  flock 9
fi

for project in "${projects[@]}"; do
  running_count=$(docker ps --filter "label=com.docker.compose.project=${project}" -q | wc -l | tr -d ' ')
  total_count=$(docker ps -a --filter "label=com.docker.compose.project=${project}" -q | wc -l | tr -d ' ')

  age_rc=0
  newest_epoch=$(project_newest_epoch "$project") || age_rc=$?
  now_epoch=$(date +%s)

  # A project whose age cannot be read is left alone AND reported, rather than
  # falling through as "not young, not stale" — that silence is how a janitor
  # stops working without anyone noticing. The non-zero exit below is what
  # carries it to the daily health check.
  if [ "$age_rc" -eq 1 ]; then
    echo "AGE?  $project (running: $running_count, total: $total_count, container age unreadable — not reaping)" >&2
    undetermined=$((undetermined + 1))
    continue
  fi

  # Checked FIRST, and for every project regardless of whether anything is
  # running. An explicit --project= or --include-running is a deliberate "clean
  # this now" and is exempt; a sweep is not.
  if [ -z "$PROJECT" ] && [ "$INCLUDE_RUNNING" -ne 1 ] && [ "$MIN_AGE_MINUTES" -gt 0 ] \
    && [ "$age_rc" -eq 0 ] && [ "$newest_epoch" -gt $((now_epoch - MIN_AGE_MINUTES * 60)) ]; then
    echo "YOUNG $project (running: $running_count, total: $total_count, newer than ${MIN_AGE_MINUTES}m — may be starting)"
    skipped_young=$((skipped_young + 1))
    continue
  fi

  if [ -n "$MAX_AGE_MINUTES" ] && [ "$age_rc" -eq 0 ] \
    && [ "$newest_epoch" -le $((now_epoch - MAX_AGE_MINUTES * 60)) ]; then
    echo "STALE $project (running: $running_count, total: $total_count, newest container older than ${MAX_AGE_MINUTES}m)"
  elif [ "$running_count" -gt 0 ] && [ "$INCLUDE_RUNNING" -ne 1 ]; then
    echo "SKIP  $project (running containers: $running_count, total: $total_count)"
    skipped_running=$((skipped_running + 1))
    continue
  fi

  if [ "$APPLY" -eq 1 ]; then
    echo "CLEAN $project (running: $running_count, total: $total_count)"
    if docker compose -p "$project" -f "$COMPOSE_FILE" down -v --remove-orphans >/dev/null 2>&1; then
      # Best-effort follow-up cleanup in case compose metadata drift left labeled
      # networks/volumes behind.
      remove_labeled_resources "$project" || true
      cleaned=$((cleaned + 1))
    else
      echo "WARN  compose down failed for $project; trying labeled resource cleanup" >&2
      if remove_labeled_resources "$project"; then
        cleaned=$((cleaned + 1))
      else
        echo "FAIL  $project" >&2
        failed=$((failed + 1))
      fi
    fi
  else
    echo "WOULD CLEAN $project (running: $running_count, total: $total_count)"
  fi
done

if [ "$lock_fd_open" -eq 1 ]; then
  flock -u 9 || true
  exec 9>&-
fi

echo
echo "Summary:"
echo "  projects_found: ${#projects[@]}"
echo "  cleaned:         $cleaned"
echo "  skipped_running: $skipped_running"
echo "  skipped_young:   $skipped_young"
echo "  undetermined:    $undetermined"
echo "  failed:          $failed"

[ "$failed" -eq 0 ] && [ "$undetermined" -eq 0 ] || exit 1
